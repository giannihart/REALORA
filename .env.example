# =============================================================================
# Data mode
# =============================================================================
# supabase (default) | production | local (dormant fixtures; engineering only)
NEXT_PUBLIC_DATA_MODE=supabase

# =============================================================================
# Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never import into client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Seed sign-in passwords (required for `npm run seed` / `npm run seed:reset`)
SEED_PASSWORD_SELLER=change-me-seller
SEED_PASSWORD_BUYER=change-me-buyer
SEED_PASSWORD_BROKER=change-me-broker

# =============================================================================
# Vendors & integrations
# =============================================================================

# Optional. Unauthenticated NYC Open Data rate limits are fine at this volume.
SOCRATA_APP_TOKEN=

# Optional. Dropbox Sign (HelloSign). Absent API key + client id → signing hold.
# Test mode is the default; set DROPBOX_SIGN_TEST_MODE=false for live.
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_CLIENT_ID=
DROPBOX_SIGN_TEST_MODE=

# Optional. Claude contract extraction. Absent → extraction unavailable.
ANTHROPIC_API_KEY=

# Optional. Public site URL for invite links and notification deep links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Resend email. Absent → notifications write logged_only.
RESEND_API_KEY=
RESEND_FROM=REALORA <notifications@example.com>

# Optional. Twilio SMS. Absent → SMS is logged_only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional. Guards POST /api/jobs/deadline-reminders (Bearer CRON_SECRET).
CRON_SECRET=change-me-cron-secret

# Optional. Persona identity. Absent → labeled "test verification" in supabase mode.
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=

# Optional. Stripe Connect. Absent → vendor booking blocked with vendor-setup state.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Sentry errors only (no session replay).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional. Google Maps for /buy and listing location.
# Prefer the server key; the client loads it through /api/maps/key.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Apple MapKit JS (server mints tokens via /api/mapkit/token).
# MAPKIT_PRIVATE_KEY is the .p8 private key PEM (use \n for newlines in .env).
MAPKIT_TEAM_ID=
MAPKIT_KEY_ID=
MAPKIT_PRIVATE_KEY=
MAPKIT_ORIGIN=http://localhost:3000
